# ============================================================
# .zshenv —— 所有 zsh 实例（含非交互）都会加载
# 目的：仅放非交互 shell 也需要的东西（cargo / 用户级可执行目录），
#       保证脚本、cron 等非交互场景下工具同样可用
# ============================================================

# cargo（Rust 工具链；uv 等也位于 ~/.cargo/bin）
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# 用户级可执行目录（pipx / uv / 本地脚本）
export PATH="/home/novart/.local/bin:$PATH"
